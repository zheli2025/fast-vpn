{
  "verified_at": "2026-11-23",
  "hysteria": {
    "listen": ":443",
    "auth": {
      "type": "password"
    },
    "obfs": {
      "type": "salamander"
    },
    "tls": {
      "certificate_mode": "local-files"
    },
    "trafficStats": {
      "listen": "127.0.0.1:25413"
    },
    "acl": {
      "rules": [
        {
          "outbound": "reject",
          "match": "cidr(\"127.0.0.0/8\") || cidr(\"169.254.0.0/16\") || cidr(\"10.0.0.0/8\") || cidr(\"172.16.0.0/12\") || cidr(\"192.168.0.0/16\") || cidr(\"100.64.0.0/10\") || cidr(\"::1/128\") || cidr(\"fc00::/7\") || cidr(\"fe80::/10\")"
        },
        {
          "outbound": "direct"
        }
      ]
    }
  },
  "clash": {
    "mixed-port": 7890,
    "allow-lan": false,
    "mode": "rule",
    "log-level": "info",
    "ipv6": false,
    "proxy": {
      "type": "hysteria2",
      "port": 443,
      "obfs": "salamander",
      "skip-cert-verify": true,
      "fingerprint": "F3:B7:EA:53:74:8C:A6:D9:FE:0B:7A:15:D1:E2:E2:E9:8C:47:31:F8:DE:62:51:66:F4:32:6F:0A:B8:DC:39:11"
    },
    "rules": [
      "DOMAIN-SUFFIX,t3coderelay.com,PROXY",
      "DOMAIN-SUFFIX,t3.codes,PROXY",
      "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve",
      "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve",
      "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
      "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve",
      "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
      "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve",
      "IP-CIDR6,::1/128,DIRECT,no-resolve",
      "IP-CIDR6,fc00::/7,DIRECT,no-resolve",
      "IP-CIDR6,fe80::/10,DIRECT,no-resolve",
      "RULE-SET,cn-domain,DIRECT",
      "RULE-SET,cn-ip,DIRECT,no-resolve",
      "MATCH,PROXY"
    ],
    "providers": {
      "cn-domain": {
        "type": "http",
        "behavior": "domain",
        "format": "mrs",
        "path": "./rule-set/geosite-cn.mrs",
        "interval": 86400
      },
      "cn-ip": {
        "type": "http",
        "behavior": "ipcidr",
        "format": "mrs",
        "path": "./rule-set/geoip-cn.mrs",
        "interval": 86400
      }
    }
  }
}
